{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "z-biz-tool-mind",
  "version": "0.1.0",
  "identifier": "com.zifang.z-biz-tool-mind",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "z-biz-tool-mind",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https: http://localhost:* ws://localhost:*",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://raw.githubusercontent.com/z-biz-tool/z-biz-tool-mind/main/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY5MjA2OThBNzlDN0IyNkUKUldSdXNzZDVpbWtnK2MvNSthMmJ5MU1nTmY5U2IrNFUzMURxdjBTQlpUNElwVGRJSHZDTG1FNFMK",
      "//": "mind 原为 private 仓、raw latest.json 不可匿名访问，才把更新通道按设计静默降级；2026-10-30 起本仓已公开，降级前提消失，正式接上官方更新通道。pubkey 与 db/file/sys 同一把，私钥存 GitHub Secrets（TAURI_SIGNING_PRIVATE_KEY）。"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "publisher": "z-biz-tool",
    "license": "MIT",
    "copyright": "Copyright © 2026 z-biz-tool",
    "category": "Productivity",
    "shortDescription": "亿图脑图 MindMaster 复刻：以树形节点为唯一事实源的结构化思考工具",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["emmx"],
        "name": "emmx",
        "description": "EMMX Mind Map Document",
        "mimeType": "application/zip",
        "role": "Editor"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "SimpChinese"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true
    }
  }
}
